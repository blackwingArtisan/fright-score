# Director for the CLI: local (default, free, offline) or bedrock (Amazon Bedrock, paid).
FRIGHT_DIRECTOR=local
# Director for the web app build: local (default) or remote (POSTs to /api/compose).
VITE_FRIGHT_DIRECTOR=local

# Only needed for the bedrock director / the /api/compose function.
# AWS_REGION=us-east-1
# FRIGHT_BEDROCK_MODEL=us.amazon.nova-pro-v1:0
# AWS credentials come from the standard AWS provider chain (or Pages secrets for the function).
