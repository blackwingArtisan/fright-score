{
  "name": "fright-score",
  "version": "0.1.0",
  "description": "Original, royalty-free horror scores from an AI director and an emulated 4-operator FM synthesis chip.",
  "author": "Stubborn Otter Software",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --port 3120 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 3121 --strictPort",
    "typecheck": "tsc --noEmit",
    "score": "tsx src/cli/score.ts",
    "test": "npm run typecheck && npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "check:determinism": "node scripts/check-determinism.mjs",
    "bench": "tsx scripts/bench.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1170.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/pirata-one": "^5.3.0",
    "zod": "^4.6.7"
  }
}
